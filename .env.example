# Central TCP chat server
CHAT_HOST=0.0.0.0
CHAT_PORT=5050

# Local React-to-TCP bridge
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3000

# PostgreSQL connection used by the central server
DATABASE_URL=postgresql://chat_user:chat_password@127.0.0.1:5432/socket_chat
# Optional schema override. The application normally uses public.
DATABASE_SCHEMA=public

# Local Hugging Face Transformers.js chatbot
HF_LOCAL_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct
HF_DTYPE=q4
HF_CACHE_DIR=.cache/huggingface
HF_ALLOW_REMOTE_MODELS=true
HF_MAX_NEW_TOKENS=200
# Set this only when using model files already downloaded on the server.
# HF_LOCAL_MODEL_PATH=/absolute/path/to/models

# Docker Compose PostgreSQL settings
POSTGRES_DB=socket_chat
POSTGRES_USER=chat_user
POSTGRES_PASSWORD=chat_password
POSTGRES_PORT=5432
